# Melanite v2 — environment template
#
# Copy to .env.local and fill in. Never commit .env.local; .gitignore covers .env*.
#
# STRIPE MODE MATTERS MORE THAN ANYTHING ELSE HERE. Test and live are separate universes —
# an object created in one is invisible to the other. A test key against a live price fails
# with "No such price", at checkout, a long way from the cause.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Neon connection string. Use the UNPOOLED endpoint for migrations and bulk loads.
DATABASE_URL=postgresql://user:password@host.neon.tech/neondb?sslmode=require

# ---------------------------------------------------------------------------
# Xano — MIGRATION ONLY
# ---------------------------------------------------------------------------
# Metadata API access token, read scopes only. Used by scripts/etl/stage.ts to pull v1 data.
# Not used at runtime; the app never talks to Xano.
XANO_PAT=

# ---------------------------------------------------------------------------
# Stripe — READ.  ALWAYS LIVE, in every environment.
# ---------------------------------------------------------------------------
# Restricted, read-only (rk_live_...). This is the migration reading REAL history, not a
# runtime key, so it does not follow the environment. Pointed at a sandbox it would stage
# empty files and the import would silently produce nothing.
# Used only by scripts/etl/stage.ts.
STRIPE_SECRET_KEY=rk_live_...

# ---------------------------------------------------------------------------
# Stripe — WRITE.  Sandbox in development, live in production.
# ---------------------------------------------------------------------------
# Creates checkout sessions, billing portal sessions, Connect accounts and account links.
#
# A SEPARATE variable from the read key on purpose: giving that one write scope would
# silently grant every existing read path the ability to move money.
#
# Development: sk_test_... or a restricted rk_test_... from your sandbox.
# Production:  a restricted live key with write on Checkout Sessions, Billing Portal
#              Sessions, Customers, Accounts and Account Links.
STRIPE_SECRET_KEY_WRITE=

# The medical-director subscription price. MUST match the mode of the write key above.
#
# platform_settings.medical_director_price_id holds the LIVE id, imported from Xano. This
# overrides it so development never has to edit production configuration to test a flow.
# Leave UNSET in production — the value belongs in the database there.
STRIPE_MD_PRICE_ID=

# Signing secret for THIS app's webhook endpoint (/api/webhooks/stripe).
#
# Locally this comes from the Stripe CLI, NOT from a dashboard destination. The destinations
# in the Stripe dashboard point at v1's Xano URLs; their secrets verify events sent to Xano
# and are unrelated to this app. Stripe also cannot reach localhost, which is why the CLI
# tunnels:
#
#   stripe listen --forward-to localhost:3000/api/webhooks/stripe
#
# It prints a whsec_ for that session, which changes when you restart the listener.
#
# Production: create ONE destination pointing at https://<domain>/api/webhooks/stripe and use
# its secret. One, not four — v2 dispatches on event type, so a single endpoint covers every
# source. At cutover, disable v1's four Xano destinations or both systems will react to the
# same payments.
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Email — optional
# ---------------------------------------------------------------------------
# Without a key, password reset links are logged to the server console instead of sent, and
# `npm run db:reset-link` prints them for hand-delivery. v1 used Resend, so the same account
# works here.
RESEND_API_KEY=
RESEND_FROM=Melanite Laser Suite <noreply@melanitesuite.com>

# Absolute base URL, used to build reset and Stripe return links. Falls back to the request
# host when unset, which is right for local development.
APP_BASE_URL=
