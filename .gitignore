# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the template carries no secrets and documents which keys are live vs sandbox,
# which is exactly the thing that should be in version control.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Staged migration data — contains real client PII (names, phones, emails,
# treatment notes) and live Stripe records. Never commit.
scripts/etl/staged/

# Saved Playwright sessions — real credentials, never committed
e2e/.auth/
test-results/
playwright-report/

# Demo walkthrough screenshots — generated, not source.
demo/

# Role-view screenshots — generated.
demo-roles/

# Webflow redirect error exports — diagnostics for one import run, not a record of the site.
docs/melanite-laser-suite-errors-*.csv
